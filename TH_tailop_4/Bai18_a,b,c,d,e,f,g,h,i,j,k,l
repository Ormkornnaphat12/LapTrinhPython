import math
print ("BÀI 18: LAMBDA KIEM TRA SO ")
#a) So than thien
so_than_thien = lambda n: math.gcd(n, int(str(n)[::-1])) == 1
#b) So chinh phuong
so_chinh_phuong = lambda n: int(math.sqrt(n)) ** 2 == n if n >= 0 else False
#c) So dong nhat su dung all va any
so_dong_nhat_all = lambda n: n > 0 and all(char == str(n)[0] for char in str(n))
#d) So hoan thien
so_hoan_thien = lambda n: n > 1 and sum(i + (n // i if i * i != n and i != 1 else 0 ) for i in range(1, int(math.sqrt(n)) + 1) if n % i == 0) == n
#e) So phong phu
so_phong_phu = lambda n: n > 1 and sum(i + (n // i if i * i != n and i != 1 else 0) for i in range(1, int(math.sqrt(n)) + 1) if n % i == 0) > n
#f) so tang dan tu trai sang phai su dung all
so_tang_dan = lambda n:  all(str(n)[i] <= str(n)[i+1] for i in range(len(str(n)) - 1))
#g) So ArmStrong 
soArmstrong = lambda n: n > 0 and sum(int(char) ** len(str(n)) for char in str(n)) == n
#h) So nguyen to --------
# cach 3: neu n <= 1 hoac n chia chan cho bat ky so nao trong khoang tu 2 den can bac haii cua n thi n khong la so nguyen to, nguoc lai n la so nguyen to.
sNT3 = lambda n: n > 1 and not any(n % i == 0 for i in range(2, int(math.sqrt(n)) + 1))
#i) So Palindrome (or palindromic)
soPalindrome = lambda n:  str(n) == str(n)[::-1]
#j) So nguyen to Panlindrome
sntPalindrome = lambda n: str(n) == str(n)[::-1] and (n > 1 and not any (n % i == 0 for i in range(2, int(math.sqrt(n)) + 1)))
#k) So loc phat
so_loc_phat = lambda n: all(char in '68' for char in str(n))
#l) So loc phat Palindrome
slp_palindrome = lambda n: all(char in '68' for char in str(n)) and str(n) == str(n)[::-1]

rs_a, rs_b, rs_c, rs_d, rs_e, rs_f, rs_g, rs_h, rs_i, rs_j, rs_k, rs_l = [], [], [], [], [], [], [], [], [], [], [], []
